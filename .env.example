# VYBE AI — Environment Configuration

# Optional: Google Gemini API Key for enhanced conversational LLM features in "Talk to VYBE"
# If not provided, VYBE automatically uses its deterministic rule-based recommendation engine.
GEMINI_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Path (defaults to backend/vybe_wellness.db)
DB_PATH=vybe_wellness.db
